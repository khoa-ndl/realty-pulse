# Anthropic API key for copywriting and orchestration
ANTHROPIC_API_KEY=

# Perplexity API key for market research
PERPLEXITY_API_KEY=

# kie.ai API key for Nano Banana property photo generation
KIE_AI_API_KEY=

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase service role key (server-side only, never exposed to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Gmail OAuth client ID, used by the outbound MCP server to send newsletters
GMAIL_CLIENT_ID=

# Gmail OAuth client secret
GMAIL_CLIENT_SECRET=

# Gmail OAuth refresh token
GMAIL_REFRESH_TOKEN=

# Shared secret the outbound MCP server (/api/mcp/outbound) requires as a
# Bearer token on every request. Generate with: openssl rand -hex 32
MCP_OUTBOUND_TOKEN=

# This app's own public base URL, used to build absolute links (e.g. unsubscribe) in emails
NEXT_PUBLIC_APP_URL=

# Supabase anon/publishable key — browser-safe, used for client-side sign-in
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret for the scheduled-generation cron route (/api/cron/generate-issue).
# Generate with: openssl rand -hex 32
# Once this env var exists on the Vercel project, Vercel automatically sends
# it as "Authorization: Bearer $CRON_SECRET" on its own cron invocations.
CRON_SECRET=

# Sentry DSN for error tracking (client + server). Not secret — Sentry DSNs
# are designed to be public. Leave blank to disable error reporting (e.g.
# local dev). Get this from your Sentry project's Settings > Client Keys.
NEXT_PUBLIC_SENTRY_DSN=
